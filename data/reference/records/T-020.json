    {
      "id": "F-020-003",
      "entity_id": "REF-020-002",
      "topic": "busと保存",
      "statement": "Aux Cardのinternal bus既定はC。対応218eでのbus出力設定は起動後に再設定が必要と記述。すべての設定やModern版へ一般化しない。",
      "basis": "manufacturer_doc",
      "confidence": "medium",
      "source_id": "SRC-020-01",
