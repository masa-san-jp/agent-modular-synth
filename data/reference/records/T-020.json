  "facts": [
    {
      "id": "F-020-001",
      "entity_id": "REF-020-001",
      "topic": "歴史・拡張",
      "statement": "2017年の公式guideは1973年のProgram Card接続をpresetと機能拡張に使う経緯を説明し、208とAux Cardの連携を記述する。歴史的原機の全仕様を読めたことにはしない。",
      "basis": "manufacturer_doc",
      "confidence": "medium",
      "source_id": "SRC-020-01",
      "locator": "PDF p.1 Introducing the Music Easel Auxiliary Card",
      "verified_on": "2026-11-12",
      "provenance": {
        "origin_commit": "61000220d6ec7f71ef7c0054a2befcf698045faa",
        "legacy_record": "I006",
        "legacy_fact_index": 0,
        "certainty": "documented_not_measured",
        "imported_on": "2026-11-13",
        "review_status": "migration_not_reverification"
      }
    },
    {
      "id": "F-020-002",
      "entity_id": "REF-020-002",
      "topic": "音高・範囲",
      "statement": "mod amt最大時は1.2 V/oct、反対端は負方向。oscillator low範囲0.12–64 Hz、high範囲16.35–5274 Hzと記述。1 V/oct規約へ自動で同一視できない。",
      "basis": "manufacturer_doc",
      "confidence": "medium",
      "source_id": "SRC-020-01",
      "locator": "PDF p.4 The Oscillator pitch controls",
      "verified_on": "2026-11-12",
      "provenance": {
