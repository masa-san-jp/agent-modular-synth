    {
      "id": "REF-005-002",
      "kind": "signal_standard",
      "name": "VCV Rack 電圧規約",
      "maker": "VCV",
      "version": "2",
      "function_category": "system",
      "purpose": "ケーブル上の値をボルト単位で扱う信号規約(レベル、トリガー/ゲート、1V/oct、ポリフォニー)。",
      "synthesis_method": "",
      "features": [
        {
          "text": "値はボルト単位",
          "fact_ids": [
            "F-005-008"
          ]
        },
        {
          "text": "音声±5V、CV 0〜10V/±5V",
          "fact_ids": [
            "F-005-009"
          ]
        },
        {
          "text": "出力は概ね±12V内。範囲外許容も可",
          "fact_ids": [
            "F-005-010"
          ]
        },
        {
          "text": "トリガー10V/1ms、ゲート10V、受信側は0.1V/1-2Vシュミット",
          "fact_ids": [
            "F-005-011"
          ]
        },
        {
          "text": "ケーブルごと1サンプル遅延",
          "fact_ids": [
            "F-005-012"
          ]
        },
        {
          "text": "1V/oct、C4=261.6256Hz基準",
          "fact_ids": [
            "F-005-013"
          ]
        },
        {
          "text": "NaN/Infは0に置換が推奨",
          "fact_ids": [
            "F-005-014"
          ]
        },
        {
          "text": "信号規約（旧 I003 調査の補足）",
          "fact_ids": [
            "F-005-043"
          ]
        },
        {
          "text": "トリガ・ゲート（旧 I003 調査の補足）",
          "fact_ids": [
            "F-005-044"
          ]
        },
        {
          "text": "時間・音高（旧 I003 調査の補足）",
          "fact_ids": [
            "F-005-045"
          ]
        }
      ],
      "constraints": [
        {
          "text": "実機慣習の近似であり厳密標準ではない",
          "fact_ids": [
            "F-005-015"
          ]
        }
