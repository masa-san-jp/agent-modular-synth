      "kind": "system",
      "name": "VCV Rack (Rack 2, Free)",
      "maker": "VCV",
      "version": "2",
      "function_category": "system",
      "purpose": "Eurorack風の仮想モジュラー環境のホストアプリ。モジュールをパッチケーブルで接続して音を作る。",
      "synthesis_method": "モジュール単位のサンプル毎処理(エンジン)によるソフトウェアモジュラー",
      "features": [
        {
          "text": "仮想ユーロラック・モジュラーのホストアプリ",
          "fact_ids": [
            "F-005-002"
          ]
        },
        {
          "text": "任意の出力を任意の入力へ接続可能",
          "fact_ids": [
            "F-005-002"
          ]
        },
        {
          "text": "サンプル毎ステップのエンジン、サンプルレート可変",
          "fact_ids": [
            "F-005-003"
          ]
        },
        {
          "text": "複数ドライバ対応のオーディオ入出力",
          "fact_ids": [
            "F-005-004"
          ]
        },
        {
          "text": "GPLv3+(非商用プラグイン例外あり)",
          "fact_ids": [
            "F-005-005"
          ]
        },
        {
          "text": "Pro版でDAWプラグイン動作(Free版にはない)",
          "fact_ids": [
            "F-005-007"
          ]
        },
        {
          "text": "再利用制約（旧 I003 調査の補足）",
          "fact_ids": [
            "F-005-048"
          ]
        }
      ],
      "constraints": [
        {
          "text": "プラグインはRackのメジャーバージョン一致が必要",
          "fact_ids": [
            "F-005-006"
          ]
        }
      ],
      "ports": [],
      "params": [],
