 "facts": [
  {
   "id": "F-001-001",
   "entity_id": "REF-001-001",
   "topic": "概要",
   "statement": "A-100は70年代の古典的モジュラーを範とするアナログ・モジュラー。2016年夏時点で125種超のモジュールがある。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-01",
   "locator": "A-100 English Main Page 冒頭",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-002",
   "entity_id": "REF-001-001",
   "topic": "パネル寸法",
   "statement": "パネル高は128.5mm(3U)、幅はHP単位(1HP=5.08mm)。ラックの有効幅は84HP。A-100のパネル幅は2HPの倍数。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-03",
   "locator": "Construction Details 冒頭〜Table 1; Order Notes",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-003",
   "entity_id": "REF-001-001",
   "topic": "電源",
   "statement": "標準電源は+12V/-12Vで、世代により650mA/1200mA/2000mA(-12Vは1200mA)。一部モジュールは+5Vも必要。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-02",
   "locator": "Technical Details Power Supply and System Bus",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-004",
   "entity_id": "REF-001-001",
   "topic": "筐体構成",
   "statement": "6Uの標準筐体は3U段2つ、各段にバスボード1枚、1枚あたり最大14モジュールを接続可能。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-03",
   "locator": "Construction Details 後半",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-005",
   "entity_id": "REF-001-002",
   "topic": "1V/oct",
   "statement": "VCOピッチは1V/oct。CVは絶対音高でなく相対量で、実ピッチはtune、レンジ、他CV入力の合算で決まる。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-02",
   "locator": "Technical Details Principles of Voltage Control",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-006",
   "entity_id": "REF-001-002",
   "topic": "ゲート閾値",
   "statement": "約+3V超をhigh、1V未満をlowと扱う。+5V〜+12Vで動作し、トリガは立ち上がりエッジで起動。全モジュールは+12Vまで耐える。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-02",
   "locator": "Technical Details Principles / Signals in the A-100",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-007",
   "entity_id": "REF-001-002",
   "topic": "信号種別と典型レベル",
   "statement": "信号は音声・制御電圧・トリガの3種。音声は約10Vpp(-5〜+5V)、LFOのCVは約-2.5〜+2.5V、ADSRは0〜+8V、トリガ/ゲート/クロックは0/+5V程度。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-02",
   "locator": "Technical Details Signals in the A-100",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-008",
   "entity_id": "REF-001-002",
   "topic": "トリガ波形",
   "statement": "トリガ/ゲート/クロックには矩形波のみ使うこと。三角やノコギリなど立上りの遅い信号は不適。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-02",
   "locator": "Technical Details Signals in the A-100",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-009",
   "entity_id": "REF-001-002",
   "topic": "役割の混用",
   "statement": "どのモジュール出力も音声・CV・トリガとして使え、信号種別の区別は原理的なもの。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-02",
   "locator": "Technical Details Signals in the A-100 末尾",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-010",
   "entity_id": "REF-001-002",
   "topic": "内部バスCV/Gate",
   "statement": "バスにはCVとGateの線があり、CV送信元とGate送信元はそれぞれ1つのみ許される。複数モジュールが受信可能。バス中央のジャンパで2領域に分割できる。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-02",
   "locator": "Technical Details Meaning and usage of the bus signal CV and Gate",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-011",
   "entity_id": "REF-001-003",
   "topic": "再現性",
   "statement": "音色は都度組み立てるもので、正確に再現できない場合があると公式概要が述べている。パッチ保存機能への言及は確認されない。",
   "basis": "manufacturer_doc",
   "confidence": "medium",
   "source_id": "SRC-001-01",
   "locator": "A-100 English Main Page 第2段落",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-012",
   "entity_id": "REF-001-004",
   "topic": "出力",
   "statement": "CV1はMIDIノートで1V/oct 0〜+5V、CV2はピッチベンド、CV3はベロシティ(0〜+5V)、CV4は任意のコントロールチェンジ(0〜+5V)。ゲートは0/+5V。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-10",
   "locator": "A-190-3 入出力と操作部の節",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-013",
   "entity_id": "REF-001-004",
   "topic": "設定",
   "statement": "MIDIチャンネル、基準音、CV4のコントローラ番号は学習ボタンで設定。ゲート電圧は+5Vまたは+12Vにジャンパ選択でき、他社機器にはS-Trigger用ケーブルがある。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-10",
   "locator": "A-190-3 入出力と操作部/ジャンパの節",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-014",
   "entity_id": "REF-001-004",
   "topic": "バス連携",
   "statement": "ジャンパによりCV1とGateを内部バスへ送出でき、A-110/A-111やA-140をフロント配線なしで制御可能。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-10",
   "locator": "A-190-3 説明部",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-015",
   "entity_id": "REF-001-005",
   "topic": "周波数と波形",
   "statement": "約8オクターブ(約15Hz〜8kHz)。矩形・ノコギリ・三角・正弦を同時出力。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-04",
   "locator": "A-110 英語説明部",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-016",
   "entity_id": "REF-001-005",
   "topic": "出力レベル",
   "statement": "出力は典型的にノコギリと矩形が8Vpp、三角と正弦が10Vpp。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-04",
   "locator": "A-110 英語説明部",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-017",
   "entity_id": "REF-001-005",
   "topic": "制御",
   "statement": "ピッチはレンジスイッチ(5段)、Tuneつまみ、CV入力で決まり、パルス幅は手動またはCVで変調可。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-04",
   "locator": "A-110 英語説明部",
   "verified_on": "2026-11-12"
  },
  {
   "id": "F-001-018",
   "entity_id": "REF-001-005",
   "topic": "バス正規化",
   "statement": "CV1はバスの内部CVに正規化され、ジャンパで解除可。CV1にケーブルを挿すとバスCVは切断される。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-001-04",
   "locator": "A-110 Technical remarks",
   "verified_on": "2026-11-12"
  },
  {
