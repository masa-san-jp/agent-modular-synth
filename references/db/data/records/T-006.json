   "entity_id": "REF-006-001",
   "topic": "Rackとの関係",
   "statement": "DPFによるRackのラッパーで、Rackのコードをフォークせず直接使う。Core相当はCardinal版に置換され、VCVのブランドは除去されている。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-006-01",
