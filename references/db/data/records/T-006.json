   "entity_id": "REF-006-001",
   "topic": "バリアント",
   "statement": "main(音声8入出力+CV10入出力)、Synth(音声2出力)、FX(音声2入出力)、Miniの4種がある。全バリアントがMIDI入出力を持つ。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-006-01",
   "locator": "README.md 'Plugin variants'",
   "verified_on": "2026-11-12"
  },
  {
