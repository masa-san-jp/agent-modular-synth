  "facts": [
    {
      "id": "F-021-001",
      "entity_id": "REF-021-001",
      "topic": "仕様の位置付け",
      "statement": "W3Cのページは『Web Audio API 1.1』W3C Working Draftで、日付は2026年9月22日と表示されていた(勧告ではなくドラフト)。",
      "basis": "manufacturer_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "文書ヘッダ",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-002",
      "entity_id": "REF-021-001",
      "topic": "スレッドモデル",
      "statement": "制御スレッド(AudioContext生成・グラフ操作)と描画スレッド(実音声計算、実時間のコールバック駆動)の2つで実装しなければならず、制御→描画は制御メッセージ、逆方向は通常のイベントループタスクで通信する。OfflineAudioContextの描画は通常スレッド。",
      "basis": "api_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "§2.2 Control Thread and Rendering Thread",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-003",
      "entity_id": "REF-021-001",
      "topic": "信号値",
      "statement": "公開される信号値は32bit浮動小数点リニアPCMで、出力先での名目範囲は[-1,1]。範囲外/NaN/無限大の出力は仕様上未定義。",
      "basis": "api_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "§5.1-5.2 Audio Signal Values",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-004",
      "entity_id": "REF-021-001",
      "topic": "サンプルレート範囲",
      "statement": "実装は3000Hz〜768000Hzのサンプルレートに対応しなければならず、範囲外はNotSupportedError。",
      "basis": "api_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "§2.4 Supported Sample Rates",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-005",
      "entity_id": "REF-021-001",
      "topic": "レンダ量子",
      "statement": "グラフ描画は固定サイズのブロック(レンダ量子)単位で、既定は128フレーム。コンテキスト生存中は一定。renderSizeHint('default'|'hardware'|整数)で変更でき、範囲は1フレーム〜サンプルレートの6倍。",
      "basis": "api_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "§2.5, §2.6; AudioContextOptions.renderSizeHint",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-006",
      "entity_id": "REF-021-001",
      "topic": "アンダーラン定義",
      "statement": "システムオーディオコールバックの負荷値(実行時間÷再生時間)が1.0を超えるとバッファアンダーラン。レンダ量子はコールバックバッファの約数とは限らない。",
      "basis": "api_doc",
      "confidence": "medium",
      "source_id": "SRC-021-01",
      "locator": "§2.6 Rendering an Audio Graph",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-007",
      "entity_id": "REF-021-002",
      "topic": "生成と再利用",
      "statement": "MDNは、何をする前にもAudioContextを作り、毎回新規に作らず1つを使い回すことを推奨し、複数の音源/パイプラインで共有してよいとする。",
      "basis": "third_party",
      "confidence": "high",
      "source_id": "SRC-021-02",
      "locator": "AudioContext 冒頭説明",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-008",
      "entity_id": "REF-021-002",
      "topic": "sampleRate",
      "statement": "生成時にsampleRateを指定でき、未指定なら既定の出力デバイスのレート。出力デバイスと異なる場合は実装が再サンプリングしなければならず、レイテンシが大きく増えることがある。",
      "basis": "api_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "§1.2 AudioContext constructor手順",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-009",
      "entity_id": "REF-021-002",
      "topic": "latencyHint",
      "statement": "latencyHintは'interactive'(既定、グリッチなしで最低遅延)・'balanced'・'playback'、または秒数(double)。解釈はブラウザの裁量。",
      "basis": "api_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "§1.2.5 AudioContextOptions",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-010",
      "entity_id": "REF-021-002",
      "topic": "baseLatency/outputLatency",
      "statement": "baseLatencyはAudioDestinationNodeからオーディオサブシステムへ渡すまでの処理遅延(グラフ内遅延は含まない)。仕様の例では二重バッファで2×128/44100≒5.8ms。outputLatencyは機材依存で動的に変化する。",
      "basis": "api_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "§1.2.2 Attributes baseLatency/outputLatency",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-011",
      "entity_id": "REF-021-002",
      "topic": "メソッド/プロパティ",
      "statement": "MDNにresume()/suspend()/close()/getOutputTimestamp()/setSinkId()(セキュアコンテキスト)等が列挙。Baseline Widely available。",
      "basis": "third_party",
      "confidence": "high",
      "source_id": "SRC-021-02",
      "locator": "AudioContext Instance properties/methods",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-012",
      "entity_id": "REF-021-002",
      "topic": "interrupted状態",
      "statement": "仕様はOSによる中断(interruption)を扱う節を持つ(2.7)。state属性に'interrupted'が現れる記述あり。",
      "basis": "api_doc",
      "confidence": "low",
      "source_id": "SRC-021-01",
      "locator": "§2.7 Handling an interruption (目次と resume()手順の記述のみ確認)",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-013",
      "entity_id": "REF-021-003",
      "topic": "実行モデル",
      "statement": "MDNによると、AudioWorkletのスクリプトはAudioWorkletGlobalScopeで実行され、ワークレットと他の音声ノードが共有する別のWebAudioスレッド上で動作して低遅延処理を提供する。BaseAudioContext.audioWorkletから取得。",
      "basis": "third_party",
      "confidence": "high",
      "source_id": "SRC-021-03",
      "locator": "AudioWorklet 冒頭",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-014",
      "entity_id": "REF-021-003",
      "topic": "セキュアコンテキスト",
      "statement": "AudioWorkletはHTTPS等のセキュアコンテキスト限定(MDNの注記)。Baseline Widely available。",
      "basis": "third_party",
      "confidence": "high",
      "source_id": "SRC-021-03",
      "locator": "AudioWorklet 冒頭注記",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-015",
      "entity_id": "REF-021-003",
      "topic": "通信",
      "statement": "AudioWorkletのportでメインスレッドとワークレット間のMessagePort通信ができ、仕様上processorOptionsで初期化データを渡せる。AudioWorkletProcessorにもMessagePort(port)がある。",
      "basis": "api_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "AudioWorkletNodeOptions.processorOptions; AudioWorkletProcessor.port",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-016",
      "entity_id": "REF-021-003",
      "topic": "処理コールバック",
      "statement": "独自プロセッサはAudioWorkletProcessorを継承しprocess()を実装し、parameterDescriptorsで音声パラメータを定義する。描画ごと(レンダ量子ごと)に呼ばれる。",
      "basis": "api_doc",
      "confidence": "medium",
      "source_id": "SRC-021-01",
      "locator": "AudioWorkletProcessCallback節の冒頭のみ確認",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-017",
      "entity_id": "REF-021-003",
      "topic": "非推奨API",
      "statement": "ScriptProcessorNodeは非推奨で、bufferSizeは256〜16384(2の冪)。AudioWorkletが後継。",
      "basis": "api_doc",
      "confidence": "medium",
      "source_id": "SRC-021-01",
      "locator": "ScriptProcessorNode節",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-018",
      "entity_id": "REF-021-004",
      "topic": "ポリシー",
      "statement": "MDNは、ブラウザが自動再生を許さず、AudioContextはユーザー操作で開始させる必要があると説明する。stateはsuspended/running/closed。",
      "basis": "third_party",
      "confidence": "high",
      "source_id": "SRC-021-04",
      "locator": "Best practices - Autoplay policy",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-019",
      "entity_id": "REF-021-004",
      "topic": "生成タイミング",
      "statement": "clickなどユーザー操作の中でAudioContextを作ればstateは自動でrunningになる。それ以外で作った場合はsuspendedとなり、ユーザー操作後にstate==='suspended'ならresume()を呼ぶ(MDNの例)。OfflineAudioContextはstartRendering()。",
      "basis": "third_party",
      "confidence": "high",
      "source_id": "SRC-021-04",
      "locator": "Best practices - Autoplay policy (サンプルコード)",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-020",
      "entity_id": "REF-021-004",
      "topic": "仕様上の扱い",
      "statement": "仕様は、UAがsuspended→runningの初期遷移を許可しない場合があり、許可するのは(例として)関連グローバルオブジェクトがsticky activationを持つ場合のみと述べる。必須要件ではなくUAの裁量。",
      "basis": "api_doc",
      "confidence": "high",
      "source_id": "SRC-021-01",
      "locator": "§1.2 AudioContext 'allowed to start'",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-021",
      "entity_id": "REF-021-004",
      "topic": "resume()",
      "statement": "resume()はPromiseを返し、Documentがfully activeでなければInvalidStateErrorでreject、closed状態でもInvalidStateError。",
      "basis": "api_doc",
      "confidence": "medium",
      "source_id": "SRC-021-01",
      "locator": "AudioContext.resume() 手順",
      "verified_on": "2026-11-13"
    },
    {
      "id": "F-021-022",
      "entity_id": "REF-021-005",
      "topic": "生成引数",
      "statement": "コンストラクタはチャンネル数・長さ(フレーム)・sampleRateを取り、描画スレッドは通常スレッドで、suspend時刻はレンダ量子の倍数に切り上げられる。startRendering()で開始する(自動再生制限の適用外とするMDN記述は別出典のためここでは断定しない)。",
      "basis": "api_doc",
      "confidence": "medium",
      "source_id": "SRC-021-01",
