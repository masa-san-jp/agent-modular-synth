 "facts": [
  {
   "id": "F-022-001",
   "entity_id": "REF-022-001",
   "topic": "history",
   "statement": "MIDI 1.0は1983-02-01導入、MMAが開発。1985年夏NAMMで詳細仕様書公開、2016年にThe MIDI Association設立、2017年に抄録版がIEC 63035。二次資料(Wikipedia)の要約。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Infobox; History節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-002",
   "entity_id": "REF-022-001",
   "topic": "channels",
   "statement": "1リンクで独立した16チャンネル。オムニon/offとモノ/ポリの組合せでデバイスの受信方法が変わる。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Technical specifications",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-003",
   "entity_id": "REF-022-001",
   "topic": "messages",
   "statement": "メッセージ=ステータスバイト+最大2データバイト。種別はChannel Voice, Channel Mode, System Common, System Real-Time, System Exclusiveの5つ。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Messages節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-004",
   "entity_id": "REF-022-002",
   "topic": "baud",
   "statement": "31,250baud(±1%)の8-N-1非同期シリアル。1バイトは開始/停止ビット込み10ビット=320マイクロ秒、正味ビットレート約25kbit/s。各バイトの先頭ビットがステータス/データを識別し、データは7ビット。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Technical specifications: Electrical",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-005",
   "entity_id": "REF-022-002",
   "topic": "electrical",
   "statement": "物理層は完全絶縁の電流ループで、送信側UARTのロー出力時に公称5mAが流れ、受信側フォトカプラを通る。DINまたはTRSコネクタを使用可。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Electrical specifications",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-006",
   "entity_id": "REF-022-003",
   "topic": "messages",
   "statement": "Channel Voice=ノートオン(ノート番号+ベロシティ+チャンネル)、ノートオフ、プログラムチェンジ、コントロールチェンジ。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Messages節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-007",
   "entity_id": "REF-022-003",
   "topic": "note_range",
   "statement": "ノート番号は0〜127でC-1〜G9、中央C(C4)は60。ピアノ88鍵(A0〜C8)を超え、周波数は約8.1758〜12543.85Hz。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Messages節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-008",
   "entity_id": "REF-022-003",
   "topic": "cc",
   "statement": "MIDI連続コントローラ番号(CCN)をデバイスのパラメータ(ディレイフィードバック、リバーブ時間等)に割当てると、その番号のメッセージで制御できる。ノブ・スイッチ・ペダルが送信側。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Technical specifications(エフェクト機器の記述)",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-009",
   "entity_id": "REF-022-004",
   "topic": "rate",
   "statement": "MIDIクロックは1拍24パルスで、BPM依存の音源やアルペジエータの同期に使う。シングルバイトのメッセージ列。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-06",
   "locator": "冒頭; Pulses per quarter note",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-010",
   "entity_id": "REF-022-004",
   "topic": "messages",
   "statement": "リアルタイムメッセージ: clock 248(0xF8), start 250(0xFA), continue 251(0xFB), stop 252(0xFC)。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-06",
   "locator": "Messages節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-011",
   "entity_id": "REF-022-004",
   "topic": "spp",
   "statement": "SPPはSystem Commonで3バイト(状態242=0xF2+7ビット2バイト、LSB先)。14ビット値は曲頭からのMIDIビート数(1ビート=16分音符=6クロック)。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-06",
   "locator": "Messages節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-012",
   "entity_id": "REF-022-005",
   "topic": "mtc",
   "statement": "MTCはテンポではなくフレームに基づく同期で、位置情報を含み途切れから復帰できる。Digidesignが開発しSysEx系メッセージで実装、1986年にMMA採用。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-07",
   "locator": "冒頭; wmidi Time code節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-013",
   "entity_id": "REF-022-005",
   "topic": "framerate",
   "statement": "クォーターフレーム/フルフレームに2ビットのレート識別(24, 25, 29.97ドロップ, 30fps)。時刻は時・分・秒・フレームをBCDでなくバイナリ符号化。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-07",
   "locator": "Time code format節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-014",
   "entity_id": "REF-022-006",
   "topic": "sysex",
   "statement": "SysExは演奏値ではなく機器の機能情報を送り、メーカー固有メッセージで機器をより細かく制御できる。MMA発行のメーカーIDが含まれる。Universal SysExはメーカー非依存の拡張。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "System Exclusive messages節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-015",
   "entity_id": "REF-022-007",
   "topic": "format",
   "statement": "Standard MIDI Fileの拡張子は.mid/.midi/.smf、メディアタイプaudio/midi、ファイル先頭はMThd(4D 54 68 64)。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Infobox (Standard MIDI File)",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-016",
   "entity_id": "REF-022-008",
   "topic": "timestamping",
   "statement": "MIDIタイムスタンプは先送りバッファで伝送ジッタを抑える手法。ベンダー実装は互換性なし。FireWire MIDI、Mac Core Audio、Linux ALSA Sequencerに組込み。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Timestamping節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-017",
   "entity_id": "REF-022-009",
   "topic": "history",
   "statement": "MIDI 2.0は2020-01-17にWinter NAMMで発表され、双方向通信と後方互換を優先。2019年1月に標準化構想の発表。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "MIDI 2.0 History",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-018",
   "entity_id": "REF-022-009",
   "topic": "specs",
   "statement": "2021時点で5仕様(M2-100-U v1.0, M2-101-UM v1.1, M2-102-U v1.0, M2-103-UM v1.0, M2-104-UM v1.0)、2023年6月に更新(M2-100-U 1.1, MIDI-CI 1.2, M2-102-U 1.1, M2-104-UM 1.1, M2-116-U 1.0)と記載。『3万2千コントローラ』等の記述は二次資料の主張で一次未確認。",
   "basis": "third_party",
   "confidence": "low",
   "source_id": "SRC-022-05",
   "locator": "MIDI 2.0 History節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-019",
   "entity_id": "REF-022-009",
   "topic": "ci",
   "statement": "MIDI-CIはUniversal SysExでプロファイル、パラメータ(プロパティ)交換、プロトコル交渉を実装。仕様は2017年11月(AMEI)、2018年1月(MMA)公開。プロパティ交換はJSONでパッチ名・コントローラ等の能力を問い合わせ/設定する。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "MIDI Capability Inquiry / Property exchange節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-020",
   "entity_id": "REF-022-010",
   "topic": "ump",
   "statement": "UMPはペイロードに応じ32/64/96/128ビット。256チャンネル(16グループ×16)、グループごとにMIDI1.0/2.0プロトコル。システム/SysEx/タイムスタンプ対応。System Real-Time/CommonはMIDI1.0と同一。DIN非対応。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "MIDI 2.0 > Universal MIDI Packet節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-021",
   "entity_id": "REF-022-010",
   "topic": "sysex8",
   "statement": "データ転送形式: SysEx8は新しい8ビット形式(Universal SysEx基盤)、Mixed Data Setは大容量データ用、SysEx7は従来の7ビット形式。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-05",
   "locator": "Data transfer formats節",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-022",
   "entity_id": "REF-022-011",
   "topic": "history",
   "statement": "OSCはCNMATのMatt WrightとAdrian Freedが開発、1997年に提案、1.0仕様は2002年に確定。2009年の1.1更新で型が追加。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-022-03",
   "locator": "What is OSC?",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-023",
   "entity_id": "REF-022-011",
   "topic": "transport",
   "statement": "OSCパケットはメッセージまたはバンドルで、サイズは常に4の倍数。UDP等では1パケット=1データグラム、TCP等のストリームでは各パケット前にint32のサイズを置く。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-022-01",
   "locator": "OSC Packets",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-024",
   "entity_id": "REF-022-011",
   "topic": "limits",
   "statement": "Wikipediaは短所として帯域・組込みプロセッサ負荷がMIDIより大きいこと、デバイス間のメッセージが標準化されていないこと、サーバーの全メッセージを自動列挙する手段が標準に無いことを挙げる。",
   "basis": "third_party",
   "confidence": "medium",
   "source_id": "SRC-022-04",
   "locator": "冒頭; 本文末尾の注",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-025",
   "entity_id": "REF-022-012",
   "topic": "types",
   "statement": "原子型: int32、float32、OSC-string(NUL終端+0〜3個のNULで4バイト整列)、OSC-blob(int32サイズ+データ+パディング)、OSC-timetag(64ビット固定小数点)。全て4バイトの倍数。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-022-01",
   "locator": "OSC Syntax > Atomic Data Types",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-026",
   "entity_id": "REF-022-012",
   "topic": "typetags",
   "statement": "タイプタグ文字列はカンマで始まり、必須はi,f,s,b。非標準型の場合に使うタグ: h,t,d,S,c,r,m,T,F,N,I,[,]。未認識タグを含むメッセージは破棄すべき。mはport id, status, data1, data2のMIDI 4バイト。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-022-01",
   "locator": "OSC Type Tag String",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-027",
   "entity_id": "REF-022-013",
   "topic": "address",
   "statement": "サーバーのOSCメソッドは葉、コンテナは枝のツリー。各名前はスペース、#、*、カンマ、/、?、[、]、{、}を含まない印字可能ASCII。アドレスはルートからのパスで/で始まる。空間は動的に変化しうる。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-022-01",
   "locator": "OSC Semantics > Address Spaces",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-028",
   "entity_id": "REF-022-013",
   "topic": "pattern",
   "statement": "パターンは同数のパート数で各パートが一致すること。?は1文字、*は0文字以上、[..]は範囲(-)や否定(!)、{a,b}は選択。同一メッセージが複数メソッドに一致したら全てに同じ引数を渡し、呼び出し順は不定。",
   "basis": "manufacturer_doc",
   "confidence": "high",
   "source_id": "SRC-022-01",
   "locator": "OSC Message Dispatching and Pattern Matching",
   "verified_on": "2026-11-13"
  },
  {
   "id": "F-022-029",
   "entity_id": "REF-022-014",
   "topic": "bundle",
   "statement": "バンドルは'#bundle'+8バイトのタイムタグ+0個以上の要素(各int32サイズ付き)。要素はメッセージまたはバンドルで再帰。入れ子のタイムタグは外側以上でなければならない。",
   "basis": "manufacturer_doc",
